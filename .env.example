APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_haneri
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Set to false only if your host intercepts SMTP (e.g. Hostinger) and you get a certificate CN mismatch
# MAIL_VERIFY_PEER=false
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Website contact form — notification recipient (internal inbox)
CONTACT_FROM_RECIPIENT=info@haneri.com

# Paid website orders are emailed here. Comma-separated if more than one inbox is needed.
ORDER_NOTIFICATION_EMAILS=info@haneri.in

# Optional fallback when Shiprocket is not saved in Admin → Settings.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION=
# SHIPROCKET_CARGO_BASE_URL=https://api.rocketbox.in/api

# Google reCAPTCHA v3 (Contact Us). Both keys required — otherwise captcha is skipped so the form stays usable.
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3). Site key is returned from GET /api/site/config.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional score threshold 0.0–1.0 (default 0.5). Lower = more permissive.
# RECAPTCHA_MIN_SCORE=0.5

# Site mode: shopping (full ecommerce) or enquiry (Send Enquiry instead of Add to Cart)
SITE_MODE=shopping
# Google Apps Script web app URL for product enquiries (required when SITE_MODE=enquiry)
GOOGLE_SHEETS_ENQUIRY_URL=

# SMS Alert (https://www.smsalert.co.in) – OTP and transactional SMS
SMSALERT_API_KEY=
SMSALERT_SENDER=HANERI
# SMSALERT_URL=https://www.smsalert.co.in/api/push.json
# Approved DLT template; {#var#} is replaced with the OTP. Override only if you have a different approved template.
# SMSALERT_OTP_TEMPLATE="Your OTP is {#var#}. Do not share this code with anyone. Team Haneri"
# DLT template ID and entity ID from SMS Alert dashboard / DLT portal (add if required by API)
# SMSALERT_TEMPLATE_ID=
# SMSALERT_ENTITY_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Dashboard → Account & Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# Delhivery (Express / Cargo MPS)
DELHIVERY_API_KEY=
DELHIVERY_TEST_MODE=false
DELHIVERY_PICKUP_NAME=HANERI HO
# Printed on tax invoices. The GSTIN's first two digits set the seller's state
# (09 is Uttar Pradesh). Same state as the buyer prints CGST + SGST; otherwise IGST.
# SELLER_GSTIN=
# SELLER_STATE=
# Registered client name shown in Delhivery One (required to prefetch multi-box waybills)
DELHIVERY_CLIENT_NAME=
